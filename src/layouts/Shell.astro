---
import { u } from '../lib/url';
// Bare document shell for full redesigns: shared SEO/meta only, no shared styles.
// Each design brings its own fonts, CSS and scripts.
import { site } from '../data/site';
interface Props { title?: string; description?: string; fonts: string; themeColor?: string }
const { title = site.title, description = site.description, fonts, themeColor = '#000000' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/png" href={u('/favicon.png')} />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <link rel="canonical" href={Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="HabitRise | The 21-Day 6 AM Habit Challenge" />
    <meta property="og:description" content="Live 6 AM sessions, the SAVERS method and a community that shows up with you. 5000+ lives transformed." />
    <meta property="og:image" content={Astro.site ? new URL(u('/img/founder-hero.webp'), Astro.site) : u('/img/founder-hero.webp')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fonts} rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
