---
import '../styles/global.css';
import '../styles/theme.css';
import { site } from '../data/site';
interface Props { title?: string; description?: string }
const { title = site.title, description = site.description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0c0b" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="HabitRise | The 21-Day 6 AM Habit Challenge" />
    <meta property="og:description" content="Live 6 AM sessions, the SAVERS method and a community that shows up with you. 5000+ lives transformed." />
    <meta property="og:image" content={Astro.site ? new URL('/img/founder-hero.webp', Astro.site) : '/img/founder-hero.webp'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Instrument+Serif:ital@1&family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href="/img/founder-hero.webp" type="image/webp" />
  </head>
  <body>
    <slot />
    <script src="../scripts/main.js"></script>
  </body>
</html>
