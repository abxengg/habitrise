---
// Founder story, in the HabitRise ("Habit App") design.
import Shell from '../layouts/Shell.astro';
import Header from '../components/streak/Header.astro';
import Footer from '../components/streak/Footer.astro';
import { streakFonts } from '../components/streak/fonts';
import '../styles/streak.css';
import { founder, stats, pricing } from '../data/site';

const tones = ['c-yellow', 'c-blue', 'c-mint', 'c-lilac'];
const chipColors = ['#f8af3c', '#ff5a36', '#4f7cff', '#23c483', '#b79cff'];
---
<Shell
  fonts={streakFonts}
  themeColor="#ffffff"
  title={`${founder.name} | Founder of HabitRise`}
  description={`The story behind HabitRise: ${founder.name}, PMP-certified delivery lead and habit coach who has trained 5,000+ students across India.`}
>
  <Header />

  <main>
    <section class="s-hero s-ab-hero">
      <div class="s-wrap s-ab-grid">
        <div>
          <span class="s-badge">Founder story</span>
          <h1>Hi, I'm <mark class="y">Mani.</mark></h1>
          <p class="s-role">{founder.name} · {founder.role}</p>
          <blockquote class="s-ab-quote">{founder.quote}</blockquote>
          <div class="s-ab-stats">
            {stats.slice(0, 3).map((s, i) => (
              <div class={`s-stat t${i + 1}`}><b>{s.value.toLocaleString('en-IN')}{s.suffix}</b><span>{s.label}</span></div>
            ))}
          </div>
        </div>
        <div class="s-ab-photo">
          <img src="/img/founder-about.webp" alt={founder.name} width="574" height="1024" fetchpriority="high" />
          <span class="s-sticker s1">PMP certified</span>
          <span class="s-sticker s3">PhD scholar · AI</span>
        </div>
      </div>
    </section>

    <section class="s-sec">
      <div class="s-wrap s-ab-body">
        <div class="s-ab-story">
          <div class="s-head"><span class="s-eyebrow">The story</span><h2>From the boardroom to 6 AM.</h2></div>
          {founder.story.map((ch, i) => (
            <article class="s-ab-chapter">
              <span class="s-step">Chapter {i + 1}</span>
              <h3>{ch.heading.charAt(0).toUpperCase() + ch.heading.slice(1)}</h3>
              {ch.paras.map(p => <p>{p}</p>)}
            </article>
          ))}
        </div>
        <aside class="s-ab-side">
          <div class="s-ab-card">
            <h4>Experience</h4>
            {founder.bio.map(p => <p>{p}</p>)}
          </div>
          <div class="s-ab-card">
            <h4>Education & credentials</h4>
            <ul>{founder.education.map(e => <li>{e}</li>)}</ul>
            <div class="s-creds">{founder.credentials.map((c, i) => <span style={`--c:${chipColors[i % 5]}`}>{c}</span>)}</div>
          </div>
        </aside>
      </div>
    </section>

    <section class="s-sec s-program">
      <div class="s-wrap">
        <div class="s-head"><span class="s-eyebrow">How I can help</span><h2>Coaching areas.</h2></div>
        <div class="s-ab-coach">
          {founder.coaching.map((c, i) => <article class={`s-card ${tones[i % 4]}`}><h3>{c.title}</h3><p>{c.text}</p></article>)}
        </div>
        <ol class="s-ab-journey">
          {founder.journey.map((j, i) => <li><span>0{i + 1}</span><div><h4>{j.title}</h4><p>{j.text}</p></div></li>)}
        </ol>
      </div>
    </section>

    <section class="s-final">
      <div class="s-wrap">
        <div class="s-final-box">
          <img class="s-final-mark" src="/img/brand/mark-white.png" alt="" width="215" height="256" />
          <h2>Rise with me at <span>6 AM.</span></h2>
          <p>21 live mornings, the S.A.V.E.R.S routine and the 6 AM crew. Build the system.</p>
          <a href="/#pricing" class="s-btn s-btn-dark">Start my streak — ₹{pricing.price}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Shell>
