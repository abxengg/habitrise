---
// Services + "I'm interested" form. Copy: src/content/services.json (placeholder services for now).
import { u } from '../lib/url';
import Shell from '../layouts/Shell.astro';
import Header from '../components/streak/Header.astro';
import Footer from '../components/streak/Footer.astro';
import { streakFonts } from '../components/streak/fonts';
import Phone from '../components/streak/Phone.astro';
import '../styles/streak.css';
import { services as c, settings, founder, t, href } from '../lib/content';

const tones = ['c-yellow', 'c-blue', 'c-mint', 'c-lilac'];
const f = c.interest;
const site = Astro.site!;
const abs = (p: string) => new URL(u(p), site).href;
const jsonLd = [
  ...c.services.map(s => ({
    '@context': 'https://schema.org', '@type': 'Service',
    name: s.title, description: t(s.text), serviceType: s.tagline,
    provider: { '@id': abs('/') + '#org' }, areaServed: 'IN',
    url: abs('/services') + '#' + s.id,
    ...(s.id === 'challenge' ? { offers: { '@type': 'Offer', price: settings.pricing.student.price, priceCurrency: 'INR', url: abs('/register') } } : {}),
  })),
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: settings.brand.name, item: abs('/') },
      { '@type': 'ListItem', position: 2, name: c.hero.tag, item: abs('/services') },
    ],
  },
];
---
<Shell fonts={streakFonts} title={c.seo.title} description={c.seo.description} jsonLd={jsonLd}>
  <Header />

  <main id="main" tabindex="-1">
    <section class="s-hero s-sv-hero">
      <div class="s-wrap">
        <div class="s-head">
          <span class="s-eyebrow">{c.hero.tag}</span>
          <h1>{c.hero.title}</h1>
          <p>{t(c.hero.text)}</p>
        </div>
        <!-- who is it for? filter -->
        <div class="s-sv-filter" role="group" aria-label={c.hero.filterLabel}>
          <span>{c.hero.filterLabel}</span>
          {c.hero.filters.map((fl, i) => <button type="button" data-filter={fl.id} aria-pressed={i === 0 ? 'true' : 'false'}>{fl.label}</button>)}
        </div>

        <div class="s-sv-grid">
          {c.services.map((s, i) => (
            <article class={`s-card ${tones[i % 4]} s-sv-card`} id={s.id} data-for={s.for.join(' ')}>
              <div class="s-sv-top">
                <span class="s-sv-icon" aria-hidden="true">{s.icon}</span>
                <span class="s-step">{s.tagline}</span>
                <span class="s-sv-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h2>{s.title}</h2>
              <p>{t(s.text)}</p>
              <dl class="s-sv-meta">
                <div><dt>{c.labels.bestFor}</dt><dd>{s.bestFor}</dd></div>
                <div><dt>{c.labels.format}</dt><dd>{s.format}</dd></div>
                <div><dt>{c.labels.duration}</dt><dd>{s.duration}</dd></div>
              </dl>
              <ul>{s.points.map(p => <li>{t(p)}</li>)}</ul>
              <div class="s-sv-foot">
                <b>{t(s.price)}</b>
                <a href={href(s.buttonHref)} class:list={['s-btn', s.buttonHref.startsWith('/') ? 's-btn-dark' : 's-btn-line']} data-service={s.title}>{s.button} <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- proof -->
    <section class="s-sec s-tight-top">
      <div class="s-wrap s-sv-proof">
        {c.proof.map(pf => <div class="s-stat"><b>{pf.value}</b><span>{pf.label}</span></div>)}
      </div>
    </section>

    <!-- how we work together -->
    <section class="s-sec">
      <div class="s-wrap">
        <div class="s-head"><span class="s-eyebrow">{c.process.tag}</span><h2>{c.process.title}</h2></div>
        <ol class="s-sv-steps">
          {c.process.steps.map((st, i) => <li><span>{i + 1}</span><h3>{st.title}</h3><p>{t(st.text)}</p></li>)}
        </ol>
      </div>
    </section>

    <section class="s-sec s-program" id="interest">
      <div class="s-wrap">
        <div class="s-head">
          <span class="s-eyebrow">{f.tag}</span>
          <h2>{f.title}</h2>
          <p>{t(f.text)}</p>
        </div>
        <!-- the enquiry is a chat: HabitRise asks, you answer in your own bubbles -->
        <form class="s-chatform" data-hr-form data-kind="interest" data-endpoint={settings.forms.endpoint}
          data-msg-sending={f.sending} data-msg-success={f.success} data-msg-error={f.error} data-msg-not-configured={f.notConfigured}>
          <div class="s-cf-head">
            <img src={u('/img/brand/mark-black.png')} alt="" width="215" height="256" />
            <div><b>{f.previewName}</b><small>{f.previewStatus}</small></div>
            <span class="s-cf-dot" aria-hidden="true"></span>
          </div>

          <div class="s-cf-body">
            <p class="s-cf-q">{f.askService}</p>
            <div class="s-cf-a">
              <div class="s-chips s-cf-chips" role="radiogroup" aria-label={f.serviceLabel}>
                <div>{c.services.map(sv => <label><input type="radio" name="service" value={sv.title} required checked={sv.id === 'coaching'} /><em>{sv.title}</em></label>)}</div>
              </div>
            </div>

            <p class="s-cf-q" id="q-name">{f.askName}</p>
            <div class="s-cf-a">
              <label><span class="sr">{f.nameLabel}</span><input name="name" autocomplete="name" required maxlength="80" placeholder={f.namePlaceholder} aria-labelledby="q-name" /></label>
            </div>

            <p class="s-cf-q">{f.askContact}</p>
            <div class="s-cf-a s-cf-two">
              <Phone label={f.phoneLabel} placeholder={f.phonePlaceholder} />
              <label><span>{f.emailLabel}</span><input name="email" type="email" autocomplete="email" maxlength="120" placeholder={f.emailPlaceholder} /></label>
            </div>

            <p class="s-cf-q" id="q-org">{f.askOrg}</p>
            <div class="s-cf-a">
              <label><span class="sr">{f.organisationLabel}</span><input name="organisation" maxlength="120" placeholder={f.organisationPlaceholder} aria-labelledby="q-org" /></label>
            </div>

            <p class="s-cf-q" id="q-msg">{f.askMessage}</p>
            <div class="s-cf-a">
              <label><span class="sr">{f.messageLabel}</span><textarea name="message" rows="2" maxlength="1000" placeholder={f.messagePlaceholder} aria-labelledby="q-msg"></textarea></label>
              <span class="s-ticks" aria-hidden="true">✓✓</span>
            </div>

            <!-- after sending: typing… then a reply -->
            <div class="s-bub-slot s-cf-reply">
              <p class="s-bub in s-typing" aria-hidden="true"><i></i><i></i><i></i></p>
              <p class="s-bub in s-reply">{f.previewReply}</p>
            </div>
            <p class="s-form-status" data-status hidden role="status" aria-live="polite"></p>
            <label class="np-hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <div class="s-cf-foot">
            <small>{f.composerHint}</small>
            <button type="submit" class="s-btn s-btn-sun">{f.submit} <span aria-hidden="true">→</span></button>
          </div>
        </form>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import { wireForms } from '../scripts/forms';
    wireForms();
    // "Who is it for?" filter: shows only the services for that group
    const cards = [...document.querySelectorAll<HTMLElement>('.s-sv-card')];
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b => b.addEventListener('click', () => {
      document.querySelectorAll('[data-filter]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
      const want = b.dataset.filter!;
      cards.forEach(c => c.classList.toggle('s-dim', want !== 'all' && !c.dataset.for!.split(' ').includes(want)));
    }));

    // "I'm interested" buttons preselect their service
    document.querySelectorAll<HTMLAnchorElement>('a[data-service]').forEach(a => a.addEventListener('click', () => {
      const r = document.querySelector<HTMLInputElement>(`input[name="service"][value="${CSS.escape(a.dataset.service!)}"]`);
      if (r && a.getAttribute('href')?.startsWith('#')) { r.checked = true; r.dispatchEvent(new Event('change', { bubbles: true })); }
    }));

    // after sending, the chat shows blue ticks, "typing…" and a reply; editing again resets it
    const chatForm = document.querySelector<HTMLFormElement>('.s-chatform');
    chatForm?.addEventListener('hr:saved', () => chatForm.classList.add('sent'));
    chatForm?.addEventListener('input', () => chatForm.classList.remove('sent'));
  </script>
</Shell>
