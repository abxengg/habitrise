---
// Homepage — "The Habit App" design. Every word comes from src/content/home.json
// (plus founder.json for the coach), edited in Pages CMS. Prices appear only on /register.
import { u } from '../lib/url';
import Shell from '../layouts/Shell.astro';
import Header from '../components/streak/Header.astro';
import Footer from '../components/streak/Footer.astro';
import Floaters from '../components/streak/Floaters.astro';
import { streakFonts } from '../components/streak/fonts';
import '../styles/streak.css';
import { home as c, founder, t, initials, avatar } from '../lib/content';

const DONE = 14;
const chipColors = ['#f8af3c', '#ff5a36', '#4f7cff', '#23c483', '#b79cff'];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: c.faq.items.map(f => ({ '@type': 'Question', name: t(f.q), acceptedAnswer: { '@type': 'Answer', text: t(f.a) } })),
  },
];
---
<Shell fonts={streakFonts} title={c.seo.title} fullTitle description={c.seo.description} jsonLd={jsonLd}>
  <Header />

  <main>
    <!-- HERO with live streak tracker -->
    <section class="s-hero">
      <Floaters set="hero" />
      <div class="s-wrap s-hero-grid">
        <div class="s-hero-copy">
          <span class="s-badge">{t(c.hero.badge)}</span>
          <h1>{c.hero.line1}<br />{c.hero.line2} <mark class="y">{c.hero.line2Highlight}</mark><br />{c.hero.line3} <mark class="b">{c.hero.line3Highlight}</mark></h1>
          <p>{t(c.hero.text)}</p>
          <div class="s-hero-ctas">
            <a href={u('/register')} class="s-btn s-btn-sun">{t(c.hero.primaryButton)}</a>
            <a href="#how" class="s-btn s-btn-line">{t(c.hero.secondaryButton)}</a>
          </div>
          <ul class="s-mini">{c.hero.points.map(p => <li>{t(p)}</li>)}</ul>
        </div>

        <div class="s-tracker-wrap">
          <div class="s-sticker s1">{c.tracker.stickerPoints}</div>
          <div class="s-sticker s2">{c.tracker.stickerLive}</div>
          <div class="s-sticker s3">{c.tracker.stickerRating}</div>
          <div class="s-tracker" id="tracker" data-start={c.tracker.statusStart} data-growing={c.tracker.statusGrowing} data-fire={c.tracker.statusOnFire} data-done={c.tracker.statusDone}>
            <div class="s-tr-head">
              <span class="s-tr-mark"><img src={u('/img/brand/mark-black.png')} alt="" width="215" height="256" /></span>
              <div><small>{c.tracker.greeting}</small><b>{c.tracker.title}</b></div>
              <svg class="s-ring" viewBox="0 0 44 44" aria-hidden="true"><circle cx="22" cy="22" r="18" /><circle id="ring" cx="22" cy="22" r="18" /></svg>
            </div>
            <div class="s-tr-count"><b id="count">{DONE}</b><span>{c.tracker.ofDays}</span><em id="flame">{c.tracker.statusOnFire}</em></div>
            <div class="s-days" role="group" aria-label={c.tracker.ariaLabel}>
              {Array.from({ length: 21 }, (_, i) => (
                <button class:list={['s-day', { done: i < DONE, today: i === DONE }]} data-day={i + 1} aria-pressed={i < DONE ? 'true' : 'false'}>{i < DONE ? '✓' : i + 1}</button>
              ))}
            </div>
            <div class="s-tr-today">
              <small>{c.tracker.todayLabel}</small>
              <div class="s-chips">{c.savers.map((s, i) => <button class:list={['s-chip', { on: i < 4 }]}>{s.title}</button>)}</div>
            </div>
            <p class="s-tr-hint">{c.tracker.hint}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- audience strip -->
    <section class="s-strip">
      <div class="s-marquee" aria-label={c.audienceStrip.ariaLabel}>
        <div class="s-marquee-track">
          {[0, 1].map(() => c.audienceStrip.items.map((a, i) => <span style={`--c:${chipColors[i % 5]}`}>{a}</span>))}
        </div>
      </div>
    </section>

    <!-- how a morning works -->
    <section class="s-sec" id="how">
      <div class="s-wrap">
        <div class="s-head">
          <span class="s-eyebrow">{c.how.tag}</span>
          <h2>{c.how.title}</h2>
          <p>{t(c.how.text)}</p>
        </div>
        <div class="s-how">
          <article class="s-card c-yellow">
            <span class="s-step">{c.how.cards[0].time}</span>
            <h3>{c.how.cards[0].title}</h3>
            <p>{t(c.how.cards[0].text)}</p>
            <div class="s-ui s-ui-live">
              <div class="s-video"><img src={u('/img/founder-hero.webp')} alt="" width="900" height="900" loading="lazy" /><span class="s-live-tag">{c.how.liveTag}</span></div>
              <div class="s-attendees">{c.stories.items.slice(0, 5).map((s, i) => <i style={`background:${avatar(i)}`}>{initials(s.name)}</i>)}<span>{c.how.attendees}</span></div>
            </div>
          </article>
          <article class="s-card c-blue">
            <span class="s-step">{c.how.cards[1].time}</span>
            <h3>{c.how.cards[1].title}</h3>
            <p>{t(c.how.cards[1].text)}</p>
            <div class="s-ui s-ui-list">
              {c.savers.slice(0, 4).map((s, i) => <div class:list={{ done: i < 3 }}><i>{i < 3 ? '✓' : ''}</i>{s.title}</div>)}
            </div>
          </article>
          <article class="s-card c-mint">
            <span class="s-step">{c.how.cards[2].time}</span>
            <h3>{c.how.cards[2].title}</h3>
            <p>{t(c.how.cards[2].text)}</p>
            <div class="s-ui s-ui-post">
              <div><i style={`background:${avatar(0)}`}>{initials(c.how.post.name)}</i><b>{c.how.post.name}</b><small>{c.how.post.day}</small></div>
              <p>{c.how.post.text}</p>
              <span>{c.how.post.likes}</span><span>{c.how.post.comments}</span><span class="pts">{c.how.post.points}</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- stats bento -->
    <section class="s-sec s-tight">
      <div class="s-wrap s-bento">
        {c.stats.map((s, i) => <div class={`s-stat t${i}`}><b>{s.value}</b><span>{s.label}</span></div>)}
      </div>
    </section>

    <!-- program tabs -->
    <section class="s-sec s-program" id="program">
      <div class="s-wrap">
        <div class="s-head">
          <span class="s-eyebrow">{c.program.tag}</span>
          <h2>{c.program.title}</h2>
          <p>{t(c.program.text)}</p>
        </div>
        <div class="s-tabs" role="tablist">
          {c.program.weeks.map((w, i) => (
            <button role="tab" class:list={['s-tab', { on: i === 0 }]} data-tab={i} aria-selected={i === 0 ? 'true' : 'false'}>
              <small>{c.program.levelLabel} {i + 1} · {w.days}</small>{w.title}
            </button>
          ))}
        </div>
        {c.program.weeks.map((w, wi) => (
          <div class:list={['s-panel', { on: wi === 0 }]} data-panel={wi} role="tabpanel">
            <p class="s-panel-intro">{t(w.text)}</p>
            <ol>{w.lessons.map((l, li) => <li><span>{c.program.dayLabel} {wi * 7 + li + 1}</span>{l}</li>)}</ol>
          </div>
        ))}
      </div>
    </section>

    <!-- community: Skool group card -->
    <section class="s-sec" id="community">
      <div class="s-wrap">
        <div class="s-head s-center">
          <span class="s-eyebrow">{c.community.tag}</span>
          <h2>{c.community.title}</h2>
          <p>{t(c.community.text)}</p>
        </div>
        <div class="s-skool">
          <article class="s-group">
            <div class="s-cover"><img src={u('/img/brand/mark-white.png')} alt="" width="215" height="256" /></div>
            <div class="s-group-body">
              <span class="s-group-icon"><img src={u('/img/brand/mark-black.png')} alt="" width="215" height="256" /></span>
              <h3>{c.community.groupName}</h3>
              <p class="s-meta">{t(c.community.groupMeta)}</p>
              <p>{t(c.community.groupText)}</p>
              <div class="s-members">{c.stories.items.map((s, i) => <i style={`background:${avatar(i)}`}>{initials(s.name)}</i>)}<span>{c.community.membersMore}</span></div>
              <a href={u('/register')} class="s-btn s-btn-dark">{c.community.button}</a>
            </div>
          </article>
          <aside class="s-board">
            <h4>{c.community.leaderboardTitle}</h4>
            <ol>{c.stories.items.slice(0, 5).map((s, i) => <li><span>{i + 1}</span><i style={`background:${avatar(i)}`}>{initials(s.name)}</i>{s.name.split(' ')[0]}<b>+{212 - i * 17}</b></li>)}</ol>
            <h4>{c.community.levelsTitle}</h4>
            <div class="s-levels">{c.community.levels.map(l => <span><i>{l.level}</i>{l.name}</span>)}</div>
            <p class="s-note">{c.community.note}</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- founder -->
    <section class="s-sec s-founder" id="founder">
      <div class="s-wrap s-founder-card">
        <div class="s-founder-img"><img src={u('/img/founder-sitting.webp')} alt={founder.name} width="576" height="1024" loading="lazy" /></div>
        <div>
          <span class="s-eyebrow">{c.founderSection.tag}</span>
          <h2>{c.founderSection.title}</h2>
          <p class="s-role">{founder.name} · {founder.role}</p>
          <blockquote>{founder.quote}</blockquote>
          <p>{t(founder.homeBio)}</p>
          <div class="s-creds">{founder.credentials.map((cr, i) => <span style={`--c:${chipColors[i % 5]}`}>{cr}</span>)}</div>
          <a href={u('/about')} class="s-btn s-btn-line">{c.founderSection.button}</a>
        </div>
      </div>
    </section>

    <!-- stories as chat -->
    <section class="s-sec" id="stories">
      <div class="s-wrap s-chat-grid">
        <div class="s-head">
          <span class="s-eyebrow">{c.stories.tag}</span>
          <h2>{c.stories.title}</h2>
          <p>{t(c.stories.text)}</p>
        </div>
        <div class="s-chat">
          <div class="s-chat-top"><b>{c.stories.chatTitle}</b><small>{c.stories.chatMembers}</small></div>
          {c.stories.items.map((s, i) => (
            <div class:list={['s-msg', { right: i % 2 === 1 }]}>
              <i style={`background:${avatar(i)}`}>{initials(s.name)}</i>
              <div><small>{s.name} · {s.role}</small><p>{s.quote}</p><span>{s.result}</span></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- faq -->
    <section class="s-sec" id="faq">
      <div class="s-wrap">
        <div class="s-head s-center"><span class="s-eyebrow">{c.faq.tag}</span><h2>{c.faq.title}</h2></div>
        <div class="s-faq">{c.faq.items.map(f => <details><summary>{t(f.q)}</summary><p>{t(f.a)}</p></details>)}</div>
      </div>
    </section>

    <!-- final -->
    <section class="s-final">
      <div class="s-wrap">
        <div class="s-final-box">
          <img class="s-final-mark" src={u('/img/brand/mark-white.png')} alt="" width="215" height="256" />
          <div class="s-final-dots" aria-hidden="true">{Array.from({ length: 21 }, (_, i) => <i class:list={{ on: i === 0 }}></i>)}</div>
          <h2>{c.final.title} <span data-next-monday>Monday</span>{c.final.titleEnd}</h2>
          <p>{t(c.final.text)}</p>
          <a href={u('/register')} class="s-btn s-btn-dark">{c.final.button}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const $ = (s: string) => document.querySelector(s) as HTMLElement;
    const $$ = (s: string) => [...document.querySelectorAll(s)] as HTMLElement[];
    // streak tracker (status words come from the CMS via data-* attributes)
    const tracker = $('#tracker');
    const ring = $('#ring');
    const C = 2 * Math.PI * 18;
    const update = () => {
      const n = $$('.s-day.done').length;
      $('#count').textContent = String(n);
      ring.style.strokeDasharray = `${(n / 21) * C} ${C}`;
      const d = tracker.dataset;
      $('#flame').textContent = (n >= 21 ? d.done : n >= 7 ? d.fire : n > 0 ? d.growing : d.start) ?? '';
    };
    $$('.s-day').forEach(d => d.addEventListener('click', () => {
      const on = d.classList.toggle('done');
      d.classList.remove('today');
      d.setAttribute('aria-pressed', String(on));
      d.textContent = on ? '✓' : d.dataset.day!;
      update();
    }));
    $$('.s-chip').forEach(c => c.addEventListener('click', () => c.classList.toggle('on')));
    update();

    // story: the streak builds itself day by day the first time the tracker is seen
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const days = $$('.s-day');
      const target = days.filter(d => d.classList.contains('done')).length;
      const today = days.findIndex(d => d.classList.contains('today'));
      days.forEach(d => { d.classList.remove('done', 'today'); d.textContent = d.dataset.day!; d.setAttribute('aria-pressed', 'false'); });
      update();
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        let i = 0;
        const step = () => {
          if (i < target) {
            const d = days[i++];
            d.classList.add('done', 'pop'); d.textContent = '✓'; d.setAttribute('aria-pressed', 'true');
            update();
            setTimeout(step, 90);
          } else if (today >= 0) days[today].classList.add('today');
        };
        setTimeout(step, 500);
      }, { threshold: .4 });
      io.observe(tracker);
    }
    // program tabs
    $$('.s-tab').forEach(t => t.addEventListener('click', () => {
      $$('.s-tab').forEach(x => { x.classList.toggle('on', x === t); x.setAttribute('aria-selected', String(x === t)); });
      $$('.s-panel').forEach(p => p.classList.toggle('on', p.dataset.panel === t.dataset.tab));
    }));
  </script>
</Shell>
