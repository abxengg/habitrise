---
import { u } from '../lib/url';
// REDESIGN 2 — "The Habit App"
// Bright, playful, product-style (habitcoach.ai + Skool). The hero is a working
// 21-day streak tracker; the community is presented like a Skool group card.
import Shell from '../layouts/Shell.astro';
import Header from '../components/streak/Header.astro';
import Footer from '../components/streak/Footer.astro';
import { streakFonts } from '../components/streak/fonts';
import '../styles/streak.css';
import { pricing, stats, audiences, savers, weeks, founder, testimonials, faqs, contact, socials, initials } from '../data/site';

const DONE = 14;
const bubbleColors = ['#f8af3c', '#ff5a36', '#4f7cff', '#23c483', '#b79cff'];
---
<Shell fonts={streakFonts} themeColor="#ffffff">
  <Header />

  <main>
    <!-- HERO with live streak tracker -->
    <section class="s-hero">
      <div class="s-wrap s-hero-grid">
        <div class="s-hero-copy">
          <span class="s-badge">🔥 5,000+ streaks started</span>
          <h1>Rise at 6.<br />Keep the <mark class="y">streak.</mark><br />Change your <mark class="b">life.</mark></h1>
          <p>HabitRise is a 21-day live habit challenge. Show up at 6 AM, tick off your six morning habits, and let a community of early risers keep you honest.</p>
          <div class="s-hero-ctas">
            <a href="#pricing" class="s-btn s-btn-sun">Start for ₹{pricing.price}</a>
            <a href="#how" class="s-btn s-btn-line">See how it works</a>
          </div>
          <ul class="s-mini">
            <li>Live on Zoom every morning</li><li>Private Skool community</li><li>Ages 12+</li>
          </ul>
        </div>

        <div class="s-tracker-wrap">
          <div class="s-sticker s1">+50 pts</div>
          <div class="s-sticker s2">🔴 Live in 2 min</div>
          <div class="s-sticker s3">⭐ 4.9/5</div>
          <div class="s-tracker" id="tracker">
            <div class="s-tr-head">
              <span class="s-tr-mark"><img src={u('/img/brand/mark-black.png')} alt="" width="215" height="256" /></span>
              <div><small>Good morning ☀️</small><b>Your 21-day streak</b></div>
              <svg class="s-ring" viewBox="0 0 44 44" aria-hidden="true"><circle cx="22" cy="22" r="18" /><circle id="ring" cx="22" cy="22" r="18" /></svg>
            </div>
            <div class="s-tr-count"><b id="count">{DONE}</b><span>/ 21 days</span><em id="flame">🔥 on fire</em></div>
            <div class="s-days" role="group" aria-label="21-day tracker, tap a day to tick it">
              {Array.from({ length: 21 }, (_, i) => (
                <button class:list={['s-day', { done: i < DONE, today: i === DONE }]} data-day={i + 1} aria-pressed={i < DONE ? 'true' : 'false'}>{i < DONE ? '✓' : i + 1}</button>
              ))}
            </div>
            <div class="s-tr-today">
              <small>Today's S.A.V.E.R.S</small>
              <div class="s-chips">
                {savers.map((s, i) => <button class:list={['s-chip', { on: i < 4 }]}>{s.title}</button>)}
              </div>
            </div>
            <p class="s-tr-hint">Tap a day — this is how members track their mornings.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- audience strip -->
    <section class="s-strip">
      <div class="s-marquee" aria-label="Who HabitRise is for">
        <div class="s-marquee-track">
          {[0, 1].map(() => audiences.map((a, i) => <span style={`--c:${bubbleColors[i]}`}>{a.title}</span>))}
          {[0, 1].map(() => ['Early risers', 'Night owls who want out', 'Readers', 'Builders'].map((t, i) => <span style={`--c:${bubbleColors[(i + 4) % 5]}`}>{t}</span>))}
        </div>
      </div>
    </section>

    <!-- how a morning works -->
    <section class="s-sec" id="how">
      <div class="s-wrap">
        <div class="s-head">
          <span class="s-eyebrow">How it works</span>
          <h2>One morning at HabitRise.</h2>
          <p>Three things happen every day for 21 days. That's the whole system.</p>
        </div>
        <div class="s-how">
          <article class="s-card c-yellow">
            <span class="s-step">6:00 AM</span>
            <h3>Join the live session</h3>
            <p>A focused 6 AM session with the founder — one topic a day, from purpose to deep work.</p>
            <div class="s-ui s-ui-live">
              <div class="s-video"><img src={u('/img/founder-hero.webp')} alt="" width="900" height="900" loading="lazy" /><span class="s-live-tag">● LIVE</span></div>
              <div class="s-attendees">{testimonials.slice(0, 5).map(t => <i style={`background:${t.color}`}>{initials(t.name)}</i>)}<span>+214 rising</span></div>
            </div>
          </article>
          <article class="s-card c-blue">
            <span class="s-step">6:45 AM</span>
            <h3>Do your six habits</h3>
            <p>Silence, Affirmations, Visualisation, Exercise, Reading, Scribing — the S.A.V.E.R.S routine.</p>
            <div class="s-ui s-ui-list">
              {savers.slice(0, 4).map((s, i) => <div class:list={{ done: i < 3 }}><i>{i < 3 ? '✓' : ''}</i>{s.title}</div>)}
            </div>
          </article>
          <article class="s-card c-mint">
            <span class="s-step">7:00 AM</span>
            <h3>Check in with the crew</h3>
            <p>Post your morning in the Skool community. Earn points, climb levels, get noticed.</p>
            <div class="s-ui s-ui-post">
              <div><i style="background:#2d9e5f">PK</i><b>Praveen</b><small>Day 14</small></div>
              <p>All six SAVERS done before 6:30 ✅</p>
              <span>👍 42</span><span>💬 9</span><span class="pts">+10 pts</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- stats bento -->
    <section class="s-sec s-tight">
      <div class="s-wrap s-bento">
        {stats.map((s, i) => (
          <div class={`s-stat t${i}`}><b>{s.value.toLocaleString('en-IN')}{s.suffix}</b><span>{s.label}</span></div>
        ))}
      </div>
    </section>

    <!-- program tabs -->
    <section class="s-sec s-program" id="program">
      <div class="s-wrap">
        <div class="s-head">
          <span class="s-eyebrow">The program</span>
          <h2>21 days, 3 levels.</h2>
          <p>Each week unlocks the next. Open to everyone aged 12 and above.</p>
        </div>
        <div class="s-tabs" role="tablist">
          {weeks.map((w, i) => (
            <button role="tab" class:list={['s-tab', { on: i === 0 }]} data-tab={i} aria-selected={i === 0 ? 'true' : 'false'}>
              <small>Level {i + 1} · {w.days}</small>{w.title}
            </button>
          ))}
        </div>
        {weeks.map((w, wi) => (
          <div class:list={['s-panel', { on: wi === 0 }]} data-panel={wi} role="tabpanel">
            <p class="s-panel-intro">{w.text}</p>
            <ol>
              {w.lessons.map((l, li) => <li><span>Day {wi * 7 + li + 1}</span>{l}</li>)}
            </ol>
          </div>
        ))}
      </div>
    </section>

    <!-- community: Skool group card -->
    <section class="s-sec" id="community">
      <div class="s-wrap">
        <div class="s-head s-center">
          <span class="s-eyebrow">The community</span>
          <h2>Your 6 AM club lives on Skool.</h2>
          <p>Every member gets the private HabitRise group: daily check-ins, the classroom, the live calendar and a leaderboard.</p>
        </div>
        <div class="s-skool">
          <article class="s-group">
            <div class="s-cover"><img src={u('/img/brand/mark-white.png')} alt="" width="215" height="256" /></div>
            <div class="s-group-body">
              <span class="s-group-icon"><img src={u('/img/brand/mark-black.png')} alt="" width="215" height="256" /></span>
              <h3>HabitRise 6 AM Club</h3>
              <p class="s-meta">🔒 Private · 5,000+ members · ₹{pricing.price} for 21 days</p>
              <p>Build discipline with people who wake up when you do. Live sessions every morning at 6:00 AM IST, lessons and replays in the classroom, and a feed full of early risers.</p>
              <div class="s-members">{testimonials.map(t => <i style={`background:${t.color}`}>{initials(t.name)}</i>)}<span>and 5,000+ more</span></div>
              <a href="#pricing" class="s-btn s-btn-dark">Join the group</a>
            </div>
          </article>
          <aside class="s-board">
            <h4>Leaderboard · this week</h4>
            <ol>
              {testimonials.slice(0, 5).map((t, i) => <li><span>{i + 1}</span><i style={`background:${t.color}`}>{initials(t.name)}</i>{t.name.split(' ')[0]}<b>+{212 - i * 17}</b></li>)}
            </ol>
            <h4>Levels</h4>
            <div class="s-levels">
              {[['1', 'Early Riser'], ['3', 'Habit Builder'], ['5', 'Disciplined'], ['9', 'HabitRise Leader']].map(([n, t]) => <span><i>{n}</i>{t}</span>)}
            </div>
            <p class="s-note">Illustrative preview</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- founder -->
    <section class="s-sec s-founder" id="founder">
      <div class="s-wrap s-founder-card">
        <div class="s-founder-img"><img src={u('/img/founder-sitting.webp')} alt={founder.name} width="576" height="1024" loading="lazy" /></div>
        <div>
          <span class="s-eyebrow">Your coach</span>
          <h2>Hi, I'm Mani 👋</h2>
          <p class="s-role">{founder.name} · {founder.role}</p>
          <blockquote>{founder.quote}</blockquote>
          <p>{founder.bio[1]}</p>
          <div class="s-creds">{founder.credentials.map((c, i) => <span style={`--c:${bubbleColors[i % 5]}`}>{c}</span>)}</div>
          <a href={u('/about')} class="s-btn s-btn-line">Read my story →</a>
        </div>
      </div>
    </section>

    <!-- stories as chat -->
    <section class="s-sec" id="stories">
      <div class="s-wrap s-chat-grid">
        <div class="s-head">
          <span class="s-eyebrow">Stories</span>
          <h2>Straight from the group chat.</h2>
          <p>What members say once the 21 days are done.</p>
        </div>
        <div class="s-chat">
          <div class="s-chat-top"><b>HabitRise Members</b><small>5,000+ members</small></div>
          {testimonials.map((t, i) => (
            <div class:list={['s-msg', { right: i % 2 === 1 }]}>
              <i style={`background:${t.color}`}>{initials(t.name)}</i>
              <div><small>{t.name} · {t.role.split(' · ')[0]}</small><p>{t.quote}</p><span>{t.result}</span></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- pricing -->
    <section class="s-sec s-pricing" id="pricing">
      <div class="s-wrap">
        <div class="s-price">
          <span class="s-badge">Early bird · save ₹{pricing.regular - pricing.price}</span>
          <h2>Everything for 21 days.</h2>
          <div class="s-amount"><b>₹{pricing.price}</b><s>₹{pricing.regular}</s><small>one-time</small></div>
          <ul>{pricing.includes.map(i => <li>{i}</li>)}</ul>
          <a href={pricing.joinUrl} class="s-btn s-btn-sun s-wide">Start my streak — ₹{pricing.price}</a>
          <p class="s-pay">Pay by UPI (GPay, PhonePe, Paytm) · next cohort starts <b data-next-monday>Monday</b></p>
        </div>
      </div>
    </section>

    <!-- faq -->
    <section class="s-sec" id="faq">
      <div class="s-wrap">
        <div class="s-head s-center"><span class="s-eyebrow">FAQ</span><h2>Good questions.</h2></div>
        <div class="s-faq">{faqs.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
      </div>
    </section>

    <!-- final -->
    <section class="s-final">
      <div class="s-wrap">
        <div class="s-final-box">
          <img class="s-final-mark" src={u('/img/brand/mark-white.png')} alt="" width="215" height="256" />
          <div class="s-final-dots" aria-hidden="true">{Array.from({ length: 21 }, (_, i) => <i class:list={{ on: i === 0 }}></i>)}</div>
          <h2>Day 1 starts <span data-next-monday>Monday</span>.</h2>
          <p>Your streak is one tap away. Build the system.</p>
          <a href="#pricing" class="s-btn s-btn-dark">Start my streak</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const $ = (s: string) => document.querySelector(s) as HTMLElement;
    const $$ = (s: string) => [...document.querySelectorAll(s)] as HTMLElement[];
    // streak tracker
    const ring = $('#ring');
    const C = 2 * Math.PI * 18;
    const update = () => {
      const n = $$('.s-day.done').length;
      $('#count').textContent = String(n);
      ring.style.strokeDasharray = `${(n / 21) * C} ${C}`;
      $('#flame').textContent = n >= 21 ? '🏆 new you' : n >= 7 ? '🔥 on fire' : n > 0 ? '🌱 growing' : 'Day 1 awaits';
    };
    $$('.s-day').forEach(d => d.addEventListener('click', () => {
      const on = d.classList.toggle('done');
      d.classList.remove('today');
      d.setAttribute('aria-pressed', String(on));
      d.textContent = on ? '✓' : d.dataset.day!;
      update();
    }));
    $$('.s-chip').forEach(c => c.addEventListener('click', () => c.classList.toggle('on')));
    update();
    // program tabs
    $$('.s-tab').forEach(t => t.addEventListener('click', () => {
      $$('.s-tab').forEach(x => { x.classList.toggle('on', x === t); x.setAttribute('aria-selected', String(x === t)); });
      $$('.s-panel').forEach(p => p.classList.toggle('on', p.dataset.panel === t.dataset.tab));
    }));
  </script>
</Shell>
