---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Audience from '../components/Audience.astro';
import Savers from '../components/Savers.astro';
import Program from '../components/Program.astro';
import Community from '../components/Community.astro';
import Founder from '../components/Founder.astro';
import Stories from '../components/Stories.astro';
import Steps from '../components/Steps.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Nav />
  <main id="top">
    <Hero />
    <Stats />
    <Founder />
    <Audience />
    <Savers />
    <Program />
    <Community />
    <Stories />
    <Steps />
    <Pricing />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Base>
