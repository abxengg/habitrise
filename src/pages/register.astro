---
// Register — plan choice + details form → Google Sheet → Razorpay link for the chosen plan.
// Copy: src/content/register.json; prices + Razorpay links: settings.json.
import { u } from '../lib/url';
import Shell from '../layouts/Shell.astro';
import Header from '../components/streak/Header.astro';
import Footer from '../components/streak/Footer.astro';
import { streakFonts } from '../components/streak/fonts';
import '../styles/streak.css';
import { register as c, settings, home, t, rich, money } from '../lib/content';

const pr = settings.pricing;
const f = c.form;
const site = Astro.site!;
const abs = (p: string) => new URL(u(p), site).href;
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: settings.brand.name, item: abs('/') },
    { '@type': 'ListItem', position: 2, name: c.hero.tag, item: abs('/register') },
  ],
}];
const plans = [
  { id: 'student', tag: c.plans.studentTag, ...pr.student },
  { id: 'others', tag: c.plans.othersTag, ...pr.others },
];
---
<Shell fonts={streakFonts} title={c.seo.title} description={c.seo.description} jsonLd={jsonLd}>
  <Header />

  <main>
    <section class="s-hero s-rg">
      <div class="s-wrap">
        <div class="s-head">
          <span class="s-eyebrow">{c.hero.tag}</span>
          <h1 set:html={rich(c.hero.title)} />
          <p>{t(c.hero.text)}</p>
        </div>

        <div class="s-rg-grid">
          <form class="s-form s-rg-form" id="register"
            data-hr-form data-kind="register" data-endpoint={settings.forms.endpoint}
            data-pay-student={pr.student.paymentUrl} data-pay-others={pr.others.paymentUrl}
            data-msg-sending={f.sending} data-msg-redirecting={f.redirecting} data-msg-no-payment-link={f.noPaymentLink}
            data-msg-error={f.error} data-msg-not-configured={f.notConfigured}>
            <fieldset class="s-rg-plans s-form-wide">
              <legend>{c.plans.title}</legend>
              {plans.map(pl => (
                <label class="s-rg-plan">
                  <input type="radio" name="plan" value={pl.id} required checked={pl.id === 'others'} />
                  <span class="s-rg-plan-tag">{pl.tag}</span>
                  <span class="s-rg-plan-name">{pl.label}</span>
                  <span class="s-rg-plan-price"><b>{money(pl.price)}</b><s>{money(pr.originalPrice)}</s></span>
                  <span class="s-rg-plan-note">{c.plans.perPerson}</span>
                  <span class="s-rg-plan-text">{t(pl.note)}</span>
                </label>
              ))}
            </fieldset>

            <h2 class="s-form-wide s-rg-title">{f.title} <small>{f.subtitle}</small></h2>
            <label class="s-form-wide"><span>{f.nameLabel}</span><input name="name" autocomplete="name" required maxlength="80" placeholder={f.namePlaceholder} /></label>
            <label><span>{f.emailLabel}</span><input name="email" type="email" autocomplete="email" required maxlength="120" placeholder={f.emailPlaceholder} /></label>
            <label><span>{f.phoneLabel}</span><input name="phone" type="tel" autocomplete="tel" required pattern="[+0-9 ()-]{10,16}" placeholder={f.phonePlaceholder} /></label>
            <label class="s-form-wide" data-college hidden><span>{f.collegeLabel}</span><input name="college" maxlength="120" placeholder={f.collegePlaceholder} /></label>
            <label><span>{f.cityLabel}</span><input name="city" autocomplete="address-level2" maxlength="60" placeholder={f.cityPlaceholder} /></label>
            <label><span>{f.ageLabel}</span><input name="age" type="number" min="12" max="99" inputmode="numeric" /></label>
            <label><span>{f.occupationLabel}</span><select name="occupation" required><option value="" disabled selected>—</option>{f.occupationOptions.map(o => <option>{o}</option>)}</select></label>
            <label><span>{f.sourceLabel}</span><select name="source"><option value="" selected>—</option>{f.sourceOptions.map(o => <option>{o}</option>)}</select></label>
            <label class="np-hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
            <label class="s-rg-consent s-form-wide"><input type="checkbox" name="consent" value="yes" required /><span>{f.consent}</span></label>
            <button type="submit" class="s-btn s-btn-sun s-wide s-form-wide">{f.submit} →</button>
            <p class="s-form-status s-form-wide" data-status hidden role="status" aria-live="polite"></p>
            <p class="s-rg-secure s-form-wide">{f.secureNote}</p>
          </form>

          <aside class="s-rg-side">
            <div class="s-rg-summary">
              <h3>{home.pricing.programName}</h3>
              <dl>{home.pricing.details.map(d => <div><dt>{d.label}</dt><dd set:html={rich(d.value)} /></div>)}</dl>
              <h4>{c.plans.includesTitle}</h4>
              <ul>{pr.includes.map(i => <li>{t(i)}</li>)}</ul>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import { wireForms } from '../scripts/forms';
    wireForms();
  </script>
</Shell>
