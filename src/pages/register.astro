---
// Join: two program tabs, each a rectangular ticket with a live stub that fills in as people type.
//   • 21-Day HabitRise Challenge: 3-step form (plan → about you → contact) → Google Sheet → Razorpay link
//   • Rise & Read 2027: plan + details → Google Sheet ("Rise & Read" tab)
// Open a tab directly with /register?program=riseread (or #rise-and-read).
// Copy: register.json (HabitRise tab), riseread.json → join/pricing/final (Rise & Read tab); prices: settings.json.
import { u } from '../lib/url';
import Shell from '../layouts/Shell.astro';
import Header from '../components/streak/Header.astro';
import Footer from '../components/streak/Footer.astro';
import { streakFonts } from '../components/streak/fonts';
import Phone from '../components/streak/Phone.astro';
import '../styles/streak.css';
import { register as c, riseread as rr, settings, founder, t, rich, money } from '../lib/content';

const pr = settings.pricing;
const f = c.form;
const tk = c.ticket;
const w = c.wizard;
const pv = c.preview;
const steps = w.steps;
const pg = c.programs;
const rj = rr.join;
const rf = rr.final;
const iamOf = (name: string) => (/student/i.test(name) ? rf.iAmOptions[0] : /professional/i.test(name) ? rf.iAmOptions[1] : '');
const site = Astro.site!;
const abs = (p: string) => new URL(u(p), site).href;
const plans = [
  { id: 'student', tag: c.plans.studentTag, ...pr.student },
  { id: 'others', tag: c.plans.othersTag, ...pr.others },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: tk.programName,
    description: t(c.seo.description),
    provider: { '@id': abs('/') + '#org' },
    inLanguage: 'en-IN',
    offers: plans.map(pl => ({ '@type': 'Offer', category: pl.label, price: pl.price, priceCurrency: 'INR', availability: 'https://schema.org/InStock', url: abs('/register') })),
    hasCourseInstance: {
      '@type': 'CourseInstance', courseMode: 'Online', courseWorkload: 'PT45M',
      courseSchedule: { '@type': 'Schedule', repeatFrequency: 'Daily', repeatCount: 21, startTime: '06:00' },
      instructor: { '@type': 'Person', name: founder.name },
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: settings.brand.name, item: abs('/') },
      { '@type': 'ListItem', position: 2, name: c.hero.tag, item: abs('/register') },
    ],
  },
];
---
<Shell fonts={streakFonts} title={c.seo.title} description={c.seo.description} jsonLd={jsonLd}>
  <Header />

  <main id="main" tabindex="-1">
    <section class="s-hero s-rg">
      <div class="s-wrap">
        <div class="s-head">
          <span class="s-eyebrow">{c.hero.tag}</span>
          <h1 set:html={rich(c.hero.title)} />
          <p>{t(c.hero.text)}</p>
        </div>

        <!-- program tabs -->
        <div class="s-prog" role="tablist" aria-label={pg.label}>
          <button type="button" role="tab" id="tab-habitrise" aria-controls="panel-habitrise" aria-selected="true" data-program="habitrise">
            <img src={u('/img/brand/mark-black.png')} alt="" width="215" height="256" /><span><b>{pg.habitrise.title}</b><small set:html={rich(pg.habitrise.meta)} /></span>
          </button>
          <button type="button" role="tab" id="tab-riseread" aria-controls="panel-riseread" aria-selected="false" data-program="riseread">
            <i aria-hidden="true">📚</i><span><b>{pg.riseread.title}</b><small set:html={rich(pg.riseread.meta)} /></span>
          </button>
        </div>

        <div role="tabpanel" id="panel-habitrise" aria-labelledby="tab-habitrise" data-panel="habitrise">
        <div class="s-wz" id="register">
          <form class="s-form s-wz-form"
            data-hr-form data-kind="register" data-endpoint={settings.forms.endpoint}
            data-pay-student={pr.student.paymentUrl} data-pay-others={pr.others.paymentUrl}
            data-msg-sending={f.sending} data-msg-redirecting={f.redirecting} data-msg-no-payment-link={f.noPaymentLink}
            data-msg-error={f.error} data-msg-not-configured={f.notConfigured}
            data-step-of={w.stepOf} novalidate>

            <div class="s-wz-head" aria-hidden="true">
              <span class="s-ticket-brand"><img src={u('/img/brand/mark-white.png')} alt="" width="215" height="256" />{settings.brand.wordmark}</span>
              <span>{tk.ticketLabel}</span>
            </div>
            <div class="s-wz-progress">
              <ol>{steps.map((s, i) => <li data-dot={i} class={i === 0 ? 'on' : ''}><b>{i + 1}</b><span>{s}</span></li>)}</ol>
              <div class="s-wz-bar"><i></i></div>
            </div>

            <!-- step 1: plan -->
            <fieldset class="s-wz-step" data-step="0">
              <legend>{c.plans.title}</legend>
              <div class="s-rg-plans">
                {plans.map(pl => (
                  <label class="s-rg-plan">
                    <input type="radio" name="plan" value={pl.id} required checked={pl.id === 'others'} data-label={pl.label} data-price={money(pl.price)} />
                    <span class="s-rg-plan-tag">{pl.tag}</span>
                    <span class="s-rg-plan-name">{pl.label}</span>
                    <span class="s-rg-plan-price"><b>{money(pl.price)}</b><s>{money(pr.originalPrice)}</s></span>
                    <span class="s-rg-plan-note">{c.plans.perPerson}</span>
                    <span class="s-rg-plan-text">{t(pl.note)}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <!-- step 2: about you -->
            <fieldset class="s-wz-step" data-step="1" hidden>
              <legend>{f.aboutTitle}</legend>
              <div class="s-wz-grid">
                <label class="s-form-wide"><span>{f.nameLabel}</span><input name="name" autocomplete="name" required maxlength="80" placeholder={f.namePlaceholder} data-pv="name" /></label>
                <div class="s-form-wide s-chips" role="radiogroup" aria-label={f.occupationLabel}>
                  <span>{f.occupationLabel}</span>
                  <div>
                    {f.occupationStudent.map(o => <label data-for="student"><input type="radio" name="occupation" value={o} required /><em>{o}</em></label>)}
                    {f.occupationOthers.map(o => <label data-for="others"><input type="radio" name="occupation" value={o} required /><em>{o}</em></label>)}
                  </div>
                </div>
                <label class="s-form-wide" data-college hidden><span>{f.collegeLabel}</span><input name="college" maxlength="120" placeholder={f.collegePlaceholder} /></label>
                <label><span>{f.cityLabel}</span><input name="city" autocomplete="address-level2" maxlength="60" placeholder={f.cityPlaceholder} data-pv="city" /></label>
                <label><span>{f.ageLabel}</span><input name="age" type="number" min="12" max="99" inputmode="numeric" /></label>
              </div>
            </fieldset>

            <!-- step 3: contact -->
            <fieldset class="s-wz-step" data-step="2" hidden>
              <legend>{f.contactTitle}</legend>
              <div class="s-wz-grid">
                <label><span data-email-label data-default-text={f.emailLabel} data-student-text={f.personalEmailLabel}>{f.emailLabel}</span><input name="email" type="email" autocomplete="email" required maxlength="120" placeholder={f.emailPlaceholder} /></label>
                <label class="s-form-wide" data-student-only hidden><span>{f.collegeEmailLabel}</span><input name="collegeEmail" type="email" autocomplete="off" maxlength="120" placeholder={f.collegeEmailPlaceholder} disabled /></label>
                <Phone label={f.phoneLabel} placeholder={f.phonePlaceholder} />
                <div class="s-form-wide s-chips" role="radiogroup" aria-label={f.sourceLabel}>
                  <span>{f.sourceLabel}</span>
                  <div>{f.sourceOptions.map(o => <label><input type="radio" name="source" value={o} /><em>{o}</em></label>)}</div>
                </div>
                <label class="np-hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
                <label class="s-rg-consent s-form-wide"><input type="checkbox" name="consent" value="yes" required /><span>{f.consent}</span></label>
              </div>
            </fieldset>

            <div class="s-wz-nav">
              <button type="button" class="s-btn s-btn-line" data-back hidden>← {w.back}</button>
              <span class="s-wz-count" data-count>{w.stepOf.replace('{n}', '1').replace('{total}', String(steps.length))}</span>
              <button type="button" class="s-btn s-btn-dark" data-next>{w.next} →</button>
              <button type="submit" class="s-btn s-btn-sun" data-submit hidden>{f.submit} →</button>
            </div>
            <p class="s-form-status" data-status hidden role="status" aria-live="polite"></p>
            <p class="s-rg-secure">{f.secureNote}</p>
          </form>

          <!-- live ticket: fills in as people type -->
          <aside class="s-wz-stub" aria-label={pv.title}>
            <span class="s-wz-side-title">{pv.title}</span>
            <div class="s-pv" data-preview>
              <div class="s-pv-top">
                <span class="s-ticket-brand"><img src={u('/img/brand/mark-black.png')} alt="" width="215" height="256" />{settings.brand.wordmark}</span>
                <span>{pv.admit}</span>
              </div>
              <b class="s-pv-name" data-pv-out="name" data-empty={pv.namePlaceholder}>{pv.namePlaceholder}</b>
              <small class="s-pv-prog">{tk.programName}</small>
              <dl>
                <div><dt>{pv.planLabel}</dt><dd data-pv-out="plan">—</dd></div>
                <div><dt>{pv.startsLabel}</dt><dd><span data-next-monday>{settings.dates.fallbackDay}</span> · {pv.startsTime}</dd></div>
                <div><dt>{pv.fromLabel}</dt><dd data-pv-out="city" data-empty={pv.fromPlaceholder}>{pv.fromPlaceholder}</dd></div>
              </dl>
              <div class="s-pv-stub">
                <b data-pv-out="price">—</b>
                <s>{money(pr.originalPrice)}</s>
                <div class="s-ticket-code" aria-hidden="true"><i></i><span>{tk.serial}</span></div>
              </div>
              <span class="s-pv-stamp" aria-hidden="true">{pv.stamp}</span>
            </div>
          </aside>
        </div>
        </div>

        <!-- Rise & Read 2027 -->
        <div role="tabpanel" id="panel-riseread" aria-labelledby="tab-riseread" data-panel="riseread" hidden>
          <div class="s-wz" id="rise-and-read">
            <form class="s-form s-wz-form s-rrj-form" data-hr-form data-kind="riseread" data-fallback-kind="interest" data-endpoint={settings.forms.endpoint}
              data-msg-sending={rf.sending} data-msg-success={rf.success} data-msg-error={rf.error} data-msg-not-configured={rf.notConfigured}>
              <div class="s-wz-head" aria-hidden="true">
                <span class="s-ticket-brand"><img src={u('/img/brand/mark-white.png')} alt="" width="215" height="256" />{settings.brand.wordmark}</span>
                <span>{rj.ticketLabel}</span>
              </div>
              <fieldset class="s-wz-step">
                <legend>{rj.planTitle}</legend>
                <div class="s-rg-plans s-rg-plans-3">
                  {rr.pricing.plans.map(pl => (
                    <label class="s-rg-plan">
                      <input type="radio" name="plan" value={pl.name} required checked={pl.highlight} data-price={pl.price} data-iam={iamOf(pl.name)} />
                      <span class="s-rg-plan-name">{pl.name}</span>
                      <span class="s-rg-plan-price"><b>{pl.price}</b></span>
                      <span class="s-rg-plan-text">{t(pl.who)}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
              <fieldset class="s-wz-step">
                <legend>{rj.detailsTitle}</legend>
                <div class="s-wz-grid">
                  <label class="s-form-wide"><span>{rf.nameLabel}</span><input name="name" autocomplete="name" required maxlength="80" placeholder={rf.namePlaceholder} /></label>
                  <Phone label={rf.phoneLabel} placeholder={rf.phonePlaceholder} />
                  <label><span data-email-label data-default-text={rf.emailLabel} data-student-text={rf.personalEmailLabel}>{rf.emailLabel}</span><input name="email" type="email" autocomplete="email" required maxlength="120" placeholder={rf.emailPlaceholder} /></label>
                <label class="s-form-wide" data-student-only hidden><span>{rf.collegeEmailLabel}</span><input name="collegeEmail" type="email" autocomplete="off" maxlength="120" placeholder={rf.collegeEmailPlaceholder} disabled /></label>
                  <div class="s-form-wide s-chips" role="radiogroup" aria-label={rf.iAmLabel}>
                    <span>{rf.iAmLabel}</span>
                    <div>{rf.iAmOptions.map((o, i) => <label><input type="radio" name="iam" value={o} required data-student={i === 0 ? '1' : undefined} /><em>{o}</em></label>)}</div>
                  </div>
                  <label class="s-form-wide"><span>{rf.orgLabel}</span><input name="organisation" maxlength="120" placeholder={rf.orgPlaceholder} /></label>
                  <input type="hidden" name="service" value={rr.seo.title} />
                  <label class="np-hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
                </div>
              </fieldset>
              <div class="s-wz-nav"><button type="submit" class="s-btn s-btn-sun s-wide">{rf.submit} →</button></div>
              <p class="s-form-status" data-status hidden role="status" aria-live="polite"></p>
              <p class="s-rg-secure">{rf.note}</p>
            </form>

            <aside class="s-wz-stub" aria-label={pv.title}>
              <span class="s-wz-side-title">{pv.title}</span>
              <div class="s-pv" data-rr-preview>
                <div class="s-pv-top">
                  <span class="s-ticket-brand"><img src={u('/img/brand/mark-black.png')} alt="" width="215" height="256" />{settings.brand.wordmark}</span>
                  <span>{pv.admit}</span>
                </div>
                <b class="s-pv-name empty" data-rr-out="name" data-empty={pv.namePlaceholder}>{pv.namePlaceholder}</b>
                <small class="s-pv-prog">{rj.programName}</small>
                <dl>
                  <div><dt>{pv.planLabel}</dt><dd data-rr-out="plan">—</dd></div>
                  <div><dt>{pv.startsLabel}</dt><dd>{rj.starts}</dd></div>
                  <div><dt>{rj.iAmPreview}</dt><dd data-rr-out="iam" data-empty="—">—</dd></div>
                </dl>
                <div class="s-pv-stub">
                  <b data-rr-out="price">—</b>
                  <div class="s-ticket-code" aria-hidden="true"><i></i><span>{rj.serial}</span></div>
                </div>
                <span class="s-pv-stamp" aria-hidden="true">{pv.stamp}</span>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import { wireForms } from '../scripts/forms';
    wireForms();

    // program tabs (HabitRise / Rise & Read); ?program=riseread or #rise-and-read opens the second one
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-program]')];
    const openProgram = (p: string, focus = false) => {
      tabs.forEach(b => b.setAttribute('aria-selected', String(b.dataset.program === p)));
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach(el => (el.hidden = el.dataset.panel !== p));
      if (focus) document.getElementById(p === 'riseread' ? 'rise-and-read' : 'register')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    tabs.forEach(b => b.addEventListener('click', () => {
      openProgram(b.dataset.program!);
      history.replaceState(null, '', b.dataset.program === 'riseread' ? '?program=riseread' : location.pathname);
    }));
    const want = new URLSearchParams(location.search).get('program') || (location.hash === '#rise-and-read' ? 'riseread' : '');
    if (want === 'riseread') openProgram('riseread', !!location.hash);

    // Rise & Read ticket: fills in as people type; the plan picks "I am a" for them
    const rform = document.querySelector<HTMLFormElement>('.s-rrj-form');
    const rpv = document.querySelector<HTMLElement>('[data-rr-preview]');
    if (rform && rpv) {
      const out = (k: string) => rpv.querySelector<HTMLElement>(`[data-rr-out="${k}"]`)!;
      const paint = () => {
        const name = (rform.elements.namedItem('name') as HTMLInputElement).value.trim();
        const n = out('name'); n.textContent = name || n.dataset.empty!; n.classList.toggle('empty', !name);
        const plan = rform.querySelector<HTMLInputElement>('input[name="plan"]:checked');
        out('plan').textContent = plan?.value ?? '—';
        const price = out('price');
        if (price.textContent !== (plan?.dataset.price ?? '—')) { price.textContent = plan?.dataset.price ?? '—'; price.classList.remove('bump'); void price.offsetWidth; price.classList.add('bump'); }
        out('iam').textContent = rform.querySelector<HTMLInputElement>('input[name="iam"]:checked')?.value ?? '—';
      };
      // Plan and "I am a" stay in step both ways: Student plan <-> Student, Professional plan <-> Working professional.
      // The Habit Rise member plan fits either, so it leaves "I am a" free.
      rform.querySelectorAll<HTMLInputElement>('input[name="plan"]').forEach(r => r.addEventListener('change', () => {
        const iam = rform.querySelector<HTMLInputElement>(`input[name="iam"][value="${CSS.escape(r.dataset.iam || '')}"]`);
        if (iam) iam.checked = true;
      }));
      rform.querySelectorAll<HTMLInputElement>('input[name="iam"]').forEach(r => r.addEventListener('change', () => {
        const plan = rform.querySelector<HTMLInputElement>('input[name="plan"]:checked');
        if (!plan || !plan.dataset.iam) return; // member plan: keep it
        const match = rform.querySelector<HTMLInputElement>(`input[name="plan"][data-iam="${CSS.escape(r.value)}"]`);
        if (match && match !== plan) { match.checked = true; match.dispatchEvent(new Event('change', { bubbles: true })); }
      }));
      rform.addEventListener('input', paint);
      rform.addEventListener('change', paint);
      rform.addEventListener('hr:saved', () => rpv.classList.add('stamped'));
      const first = rform.querySelector<HTMLInputElement>('input[name="plan"]:checked');
      if (first) first.dispatchEvent(new Event('change', { bubbles: true }));
      paint();
    }

    // 3-step wizard + live ticket preview
    const form = document.querySelector<HTMLFormElement>('.s-wz-form:not(.s-rrj-form)');
    if (form) {
      const stepsEls = [...form.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
      const dots = [...form.querySelectorAll<HTMLElement>('[data-dot]')];
      const bar = form.querySelector<HTMLElement>('.s-wz-bar i')!;
      const back = form.querySelector<HTMLButtonElement>('[data-back]')!;
      const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
      const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
      const count = form.querySelector<HTMLElement>('[data-count]')!;
      const preview = document.querySelector<HTMLElement>('[data-preview]');
      let cur = 0;

      const show = (i: number, focus = true) => {
        cur = i;
        stepsEls.forEach((s, j) => (s.hidden = j !== i));
        dots.forEach((d, j) => { d.classList.toggle('on', j === i); d.classList.toggle('done', j < i); });
        bar.style.transform = `scaleX(${(i + 1) / stepsEls.length})`;
        back.hidden = i === 0;
        next.hidden = i === stepsEls.length - 1;
        submit.hidden = !next.hidden;
        count.textContent = (form.dataset.stepOf || '').replace('{n}', String(i + 1)).replace('{total}', String(stepsEls.length));
        if (focus) {
          stepsEls[i].querySelector<HTMLElement>('input:not([type=radio]), input[type=radio]')?.focus({ preventScroll: true });
          const top = form.getBoundingClientRect().top;
          if (top < 80) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      };
      // validate only the fields of the current step
      const valid = () => {
        for (const el of stepsEls[cur].querySelectorAll<HTMLInputElement>('input')) {
          if (el.closest('[hidden]') && el.closest('[hidden]') !== stepsEls[cur]) continue;
          if (!el.checkValidity()) { el.reportValidity(); return false; }
        }
        return true;
      };
      next.addEventListener('click', () => valid() && show(cur + 1));
      back.addEventListener('click', () => show(cur - 1));
      form.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !next.hidden && (e.target as HTMLElement).tagName === 'INPUT') { e.preventDefault(); next.click(); }
      });
      // the browser checks the whole form on submit; make sure all steps are valid and jump to any that isn't
      form.addEventListener('submit', e => {
        for (let i = 0; i < stepsEls.length; i++) {
          show(i, false);
          if (!valid()) { e.stopImmediatePropagation(); e.preventDefault(); return; }
        }
      }, true);

      // live ticket
      const out = (k: string) => preview?.querySelector<HTMLElement>(`[data-pv-out="${k}"]`);
      const paint = () => {
        if (!preview) return;
        for (const k of ['name', 'city']) {
          const v = (form.elements.namedItem(k) as HTMLInputElement).value.trim();
          const o = out(k)!; o.textContent = v || o.dataset.empty || ''; o.classList.toggle('empty', !v);
        }
        const plan = form.querySelector<HTMLInputElement>('input[name="plan"]:checked');
        out('plan')!.textContent = plan?.dataset.label ?? '—';
        const price = out('price')!;
        if (price.textContent !== (plan?.dataset.price ?? '—')) {
          price.textContent = plan?.dataset.price ?? '—';
          price.classList.remove('bump'); void price.offsetWidth; price.classList.add('bump');
        }
      };
      form.addEventListener('input', paint);
      form.addEventListener('change', paint);

      // occupation choices follow the plan: student plan → school/college only; everyone else → the rest
      const syncOccupation = () => {
        const plan = form.querySelector<HTMLInputElement>('input[name="plan"]:checked')?.value ?? 'others';
        form.querySelectorAll<HTMLElement>('[data-for]').forEach(l => {
          const show = l.dataset.for === plan;
          l.hidden = !show;
          const r = l.querySelector('input')!;
          r.disabled = !show;
          if (!show) r.checked = false;
        });
      };
      form.querySelectorAll('input[name="plan"]').forEach(r => r.addEventListener('change', syncOccupation));
      form.addEventListener('reset', () => setTimeout(syncOccupation));
      syncOccupation();
      form.addEventListener('hr:saved', () => preview?.classList.add('stamped'));
      paint();
      show(0, false);
    }
  </script>
</Shell>
