---
import { faqs, contact } from '../data/site';
---
<section id="faq" style="padding-top:0">
  <div class="wrap">
    <div class="section-head center reveal">
      <span class="eyebrow">FAQ</span>
      <h2>Questions, <em>answered.</em></h2>
    </div>
    <div class="faq reveal">
      {faqs.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
      <details>
        <summary>Still have a question?</summary>
        <p>Message us on <a class="inline-link" href={contact.whatsapp}>WhatsApp</a> or email <a class="inline-link" href={`mailto:${contact.email}`}>{contact.email}</a>.</p>
      </details>
    </div>
  </div>
</section>
