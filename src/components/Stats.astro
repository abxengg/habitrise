---
import { stats } from '../data/site';
---
<div class="stats">
  <div class="wrap">
    <div class="stats-grid reveal">
      {stats.map(s => (
        <div class="stat">
          <b data-count={s.value} data-decimals={s.decimals} data-suffix={s.suffix}>{s.value.toFixed(s.decimals)}{s.suffix}</b>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</div>
