---
import Brand from './Brand.astro';
import { u } from '../../lib/url';
import { settings, href, t } from '../../lib/content';
const f = settings.footer;
// the live release number: set by the deploy workflow (SITE_VERSION), else package.json for local builds
import pkg from '../../../package.json';
const version = 'v' + (process.env.SITE_VERSION || pkg.version).replace(/^v/, '');
const nl = settings.newsletter;
const external = (h: string) => /^https?:/.test(h);
---
<footer class="s-foot" data-version={version}>
  <div class="s-wrap">
    <section class="s-news" aria-labelledby="newsTitle">
      <div class="s-news-copy">
        <h2 id="newsTitle">{nl.title}</h2>
        <p>{t(nl.text)}</p>
      </div>
      <form class="s-news-form s-letter" data-hr-form data-kind="newsletter" data-endpoint={settings.forms.endpoint}
        data-msg-sending={nl.sending} data-msg-success={nl.success} data-msg-error={nl.error} data-msg-not-configured={nl.notConfigured}>
        <span class="s-letter-stamp" aria-hidden="true"><img src={u('/img/brand/mark-black.png')} alt="" width="215" height="256" /><b>{nl.stamp}</b></span>
        <span class="s-letter-post" aria-hidden="true">{nl.postmark}</span>
        <label class="s-letter-row"><span>{nl.toLabel}</span><input name="name" autocomplete="given-name" maxlength="60" placeholder={nl.namePlaceholder} aria-label={nl.nameLabel} /></label>
        <label class="s-letter-row"><span>{nl.emailLabel}</span><input name="email" type="email" autocomplete="email" required maxlength="120" placeholder={nl.emailPlaceholder} /></label>
        <label class="np-hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
        <div class="s-letter-foot">
          <p class="s-news-note">{nl.note}</p>
          <button type="submit" class="s-btn s-btn-dark">{nl.button} <span aria-hidden="true">✉</span></button>
        </div>
        <p class="s-form-status" data-status hidden role="status" aria-live="polite"></p>
        <!-- after signing up: the fields go away and the letter shows who's subscribed -->
        <div class="s-letter-done" role="status" aria-live="polite">
          <span class="s-letter-check" aria-hidden="true">✓</span>
          <small>{nl.subscribedAs}</small>
          <b data-sub-email></b>
          <p>{nl.thanks}</p>
          <button type="button" class="s-letter-again" data-again>{nl.another}</button>
        </div>
      </form>
    </section>
    <div class="s-foot-top">
      <Brand tone="light" tagline class="s-brand-big" />
      <div class="s-foot-cols">
        {f.columns.map(c => (
          <div><h4>{c.title}</h4>{c.links.map(l => <a href={href(l.href)} target={external(l.href) ? '_blank' : undefined} rel={external(l.href) ? 'noopener' : undefined}>{l.label}</a>)}</div>
        ))}
      </div>
    </div>
    <div class="s-foot-bottom">
      <small>{t(f.copyright)}</small>
      <small class="s-foot-legal">{f.legal.map((l, i) => <>{i > 0 && ' · '}<a href={href(l.href)}>{l.label}</a></>)}</small>
      <small class="s-foot-meta">
        <a class="s-abx" href={href(f.credit.url)} target="_blank" rel="noopener author"><code>&lt;/&gt;</code> {f.credit.label} <b>{f.credit.name}</b><i aria-hidden="true"></i></a>
      </small>
    </div>
  </div>
</footer>
<!-- floating contact buttons: Instagram, LinkedIn, WhatsApp -->
<div class="s-float" id="float">
  <!-- phones: one small button that opens the three -->
  <button type="button" class="s-float-toggle" aria-expanded="false" aria-controls="float" aria-label={settings.contact.contactLabel} data-open-label={settings.contact.contactLabel} data-close-label={settings.contact.closeLabel}>
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-5.1A8 8 0 1 1 21 12z" class="i-chat"/><path d="M8 8l8 8M16 8l-8 8" class="i-close"/></svg>
  </button>
  <a class="s-float-btn s-float-ig" href={href(settings.socials.instagram)} target="_blank" rel="noopener" aria-label={settings.contact.instagramLabel}>
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
  </a>
  <a class="s-float-btn s-float-in" href={href(settings.socials.linkedin)} target="_blank" rel="noopener" aria-label={settings.contact.linkedinLabel}>
    <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11H3zM9.5 9.75h3.8v1.6h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.6 4.77 6v5.45h-4v-4.83c0-1.15-.02-2.63-1.6-2.63-1.6 0-1.85 1.25-1.85 2.55v4.91h-4z"/></svg>
  </a>
  <a class="s-wa" href={href(settings.contact.whatsapp)} target="_blank" rel="noopener" aria-label={settings.contact.whatsappLabel}>
  <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5.1-1 .1-3.3-.8-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>
</a>
</div>

<script>
  import { wireForms } from '../../scripts/forms';
  import { startMotion } from '../../scripts/motion';
  wireForms();
  startMotion();

  // phones: contact buttons fold into one; close when tapping anywhere else
  const float = document.getElementById('float');
  const toggle = float?.querySelector<HTMLButtonElement>('.s-float-toggle');
  const setOpen = (open: boolean) => {
    float!.classList.toggle('open', open);
    toggle!.setAttribute('aria-expanded', String(open));
    toggle!.setAttribute('aria-label', (open ? toggle!.dataset.closeLabel : toggle!.dataset.openLabel) || '');
  };
  toggle?.addEventListener('click', e => { e.stopPropagation(); setOpen(!float!.classList.contains('open')); });
  document.addEventListener('click', e => { if (float && !float.contains(e.target as Node)) setOpen(false); });

  // phones: the tab bar and top header slide away while scrolling down, and return on scroll up
  const phone = matchMedia('(max-width: 760px)');
  let lastY = scrollY;
  addEventListener('scroll', () => {
    const y = scrollY, nearEnd = y + innerHeight > document.documentElement.scrollHeight - 80;
    if (!phone.matches || Math.abs(y - lastY) < 8) return;
    const hide = y > lastY && y > 160 && !nearEnd;
    document.documentElement.classList.toggle('s-bars-away', hide);
    if (hide && float) setOpen(false);
    lastY = y;
  }, { passive: true });
  // newsletter: the letter flies off when the signup is saved, then a fresh one slides in
  const letter = document.querySelector<HTMLFormElement>('.s-letter');
  letter?.addEventListener('hr:saved', e => {
    const email = (e as CustomEvent).detail?.email ?? '';
    letter.querySelector<HTMLElement>('[data-sub-email]')!.textContent = email;
    letter.classList.remove('sent', 'done'); void letter.offsetWidth; letter.classList.add('sent');
    setTimeout(() => letter.classList.add('done'), 650); // swap to the "subscribed" view while the letter is out of sight
  });
  letter?.querySelector('[data-again]')?.addEventListener('click', () => {
    letter.classList.remove('done', 'sent');
    letter.querySelector<HTMLElement>('[data-status]')!.hidden = true;
    letter.querySelector<HTMLInputElement>('input[name="email"]')?.focus();
  });
</script>

<script define:vars={{ prefix: settings.dates.nextCohortPrefix }}>
  // next cohort = next Monday (IST), filled into every [data-next-monday]
  const now = new Date();
  const ist = new Date(now.getTime() + (now.getTimezoneOffset() + 330) * 60000);
  const mon = new Date(ist); mon.setDate(ist.getDate() + (((8 - ist.getDay()) % 7) || 7));
  document.querySelectorAll('[data-next-monday]').forEach(el => (el.textContent = prefix + mon.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })));
</script>
