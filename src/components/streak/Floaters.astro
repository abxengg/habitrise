---
// Decorative floating shapes drawn from the HabitRise logo (the stair "H"): amber steps,
// a tiny staircase, diamonds, a sun, sparkles and a 6:00 chip. Purely visual (aria-hidden).
// Each item bobs gently (CSS) and drifts at its own depth as the page scrolls (scripts/motion.ts).
// --x/--y position, --d parallax depth, --t animation delay, --z size.
interface Props { set?: 'hero' | 'page' }
const { set = 'page' } = Astro.props;
const step = '<svg viewBox="0 0 46 26"><polygon points="0,13 23,0 46,13 23,26" fill="#f8af3c"/></svg>';
const stepOutline = '<svg viewBox="0 0 46 26"><polygon points="2,13 23,1.5 44,13 23,24.5" fill="none" stroke="#121212" stroke-width="2.5"/></svg>';
const stairs = '<svg viewBox="0 0 60 44"><path d="M2 42h14V30h14V18h14V6h14" fill="none" stroke="#121212" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><polygon points="44,6 51,2 58,6 51,10" fill="#f8af3c"/></svg>';
const sun = '<svg viewBox="0 0 60 60"><circle cx="30" cy="30" r="12" fill="#f8af3c"/><g stroke="#f8af3c" stroke-width="4" stroke-linecap="round"><path d="M30 4v8M30 48v8M4 30h8M48 30h8M11.6 11.6l5.6 5.6M42.8 42.8l5.6 5.6M11.6 48.4l5.6-5.6M42.8 17.2l5.6-5.6"/></g></svg>';
const spark = '<svg viewBox="0 0 24 24"><path d="M12 0c1 7 5 11 12 12-7 1-11 5-12 12-1-7-5-11-12-12 7-1 11-5 12-12z" fill="#121212"/></svg>';
const items = set === 'hero'
  ? [
      { svg: step, x: '3%', y: '24%', d: .25, t: '0s', z: 1.1 },
      { svg: spark, x: '46%', y: '12%', d: .4, t: '-2s', z: .7 },
      { svg: stepOutline, x: '42%', y: '82%', d: .15, t: '-4s', z: 1 },
      { svg: sun, x: '93%', y: '8%', d: .3, t: '-1s', z: .9 },
      { svg: step, x: '95%', y: '72%', d: .35, t: '-3s', z: .8 },
    ]
  : [
      { svg: stairs, x: '5%', y: '18%', d: .3, t: '0s', z: 1 },
      { svg: step, x: '12%', y: '62%', d: .2, t: '-2s', z: 1 },
      { svg: spark, x: '86%', y: '14%', d: .45, t: '-1s', z: .75 },
      { svg: sun, x: '90%', y: '48%', d: .25, t: '-3s', z: .9 },
      { svg: stepOutline, x: '78%', y: '78%', d: .15, t: '-5s', z: 1.1 },
      { svg: '<b>6:00</b>', x: '3%', y: '86%', d: .35, t: '-4s', z: 1, chip: true },
    ];
---
<div class="s-floaters" aria-hidden="true">
  {items.map(i => (
    <span class:list={['s-fl', { 's-fl-chip': i.chip }]} style={`--x:${i.x};--y:${i.y};--d:${i.d};--t:${i.t};--z:${i.z}`}><i set:html={i.svg} /></span>
  ))}
</div>
