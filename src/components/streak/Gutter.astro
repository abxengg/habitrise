---
// Small illustrations that sit in the empty side margins of a section and relate to it
// (a 6:00 alarm clock by the hero, habit icons by "How it works", a Day-21 calendar by the
// program…). Only shown on screens wide enough to have real margins; purely decorative.
// Each drifts slightly with the scroll (scripts/motion.ts) and has a small motion of its own.
interface Item { icon: keyof typeof icons; top?: string }
interface Props { left?: Item; right?: Item }
const { left, right } = Astro.props;

const ink = '#121212', amber = '#f8af3c';
const icons = {
  clock: `<svg viewBox="0 0 80 84"><path d="M14 16l10-8M66 16l-10-8" stroke="${ink}" stroke-width="5" stroke-linecap="round"/><circle cx="40" cy="46" r="30" fill="#fff" stroke="${ink}" stroke-width="5"/><g class="gi-hand-h"><path d="M40 46V28" stroke="${ink}" stroke-width="5" stroke-linecap="round"/></g><g class="gi-hand-m"><path d="M40 46v20" stroke="${amber}" stroke-width="5" stroke-linecap="round"/></g><circle cx="40" cy="46" r="4" fill="${ink}"/><path d="M22 78l6-6M58 78l-6-6" stroke="${ink}" stroke-width="5" stroke-linecap="round"/></svg>`,
  sun: `<svg viewBox="0 0 80 80"><g class="gi-rays" stroke="${amber}" stroke-width="5" stroke-linecap="round"><path d="M40 4v10M40 66v10M4 40h10M66 40h10M14.5 14.5l7 7M58.5 58.5l7 7M14.5 65.5l7-7M58.5 21.5l7-7"/></g><circle cx="40" cy="40" r="16" fill="${amber}" stroke="${ink}" stroke-width="4"/></svg>`,
  book: `<svg viewBox="0 0 84 64"><path d="M42 12C32 4 16 4 6 8v48c10-4 26-4 36 4 10-8 26-8 36-4V8C68 4 52 4 42 12z" fill="#fff" stroke="${ink}" stroke-width="4" stroke-linejoin="round"/><path d="M42 12v48" stroke="${ink}" stroke-width="4"/><path d="M14 20c8-2 16-2 22 1M14 30c8-2 16-2 22 1M48 21c6-3 14-3 22-1M48 31c6-3 14-3 22-1" stroke="${amber}" stroke-width="4" stroke-linecap="round"/></svg>`,
  pen: `<svg viewBox="0 0 72 72"><path d="M12 60l4-16L48 12l12 12-32 32z" fill="${amber}" stroke="${ink}" stroke-width="4" stroke-linejoin="round"/><path d="M42 18l12 12M12 60l12-4" stroke="${ink}" stroke-width="4" stroke-linecap="round"/><path d="M8 66h30" stroke="${ink}" stroke-width="4" stroke-linecap="round" stroke-dasharray="1 8"/></svg>`,
  dumbbell: `<svg viewBox="0 0 84 48"><path d="M26 24h32" stroke="${ink}" stroke-width="6" stroke-linecap="round"/><rect x="14" y="8" width="12" height="32" rx="4" fill="${amber}" stroke="${ink}" stroke-width="4"/><rect x="58" y="8" width="12" height="32" rx="4" fill="${amber}" stroke="${ink}" stroke-width="4"/><path d="M6 16v16M78 16v16" stroke="${ink}" stroke-width="6" stroke-linecap="round"/></svg>`,
  calendar: `<svg viewBox="0 0 76 80"><rect x="6" y="12" width="64" height="62" rx="10" fill="#fff" stroke="${ink}" stroke-width="4"/><path d="M6 30h64" stroke="${ink}" stroke-width="4"/><rect x="8" y="14" width="60" height="14" rx="6" fill="${amber}"/><path d="M22 6v14M54 6v14" stroke="${ink}" stroke-width="5" stroke-linecap="round"/><text x="38" y="52" text-anchor="middle" font-family="Manrope,sans-serif" font-weight="800" font-size="11" fill="${ink}">DAY</text><text x="38" y="68" text-anchor="middle" font-family="Manrope,sans-serif" font-weight="800" font-size="16" fill="${ink}">21</text></svg>`,
  flame: `<svg viewBox="0 0 64 80"><g class="gi-flame"><path d="M32 4c4 14 22 22 22 44a22 22 0 0 1-44 0c0-10 6-16 10-20 0 8 4 12 8 12-4-14 2-26 4-36z" fill="${amber}" stroke="${ink}" stroke-width="4" stroke-linejoin="round"/><path d="M32 46c4 6 10 8 10 16a10 10 0 0 1-20 0c0-6 6-10 10-16z" fill="#fff" stroke="${ink}" stroke-width="4" stroke-linejoin="round"/></g></svg>`,
  chat: `<svg viewBox="0 0 92 64"><path d="M10 6h72a6 6 0 0 1 6 6v30a6 6 0 0 1-6 6H34l-14 12v-12H10a6 6 0 0 1-6-6V12a6 6 0 0 1 6-6z" fill="#fff" stroke="${ink}" stroke-width="4" stroke-linejoin="round"/><text x="46" y="33" text-anchor="middle" font-family="Manrope,sans-serif" font-weight="800" font-size="16" fill="${ink}">+10 pts</text><circle cx="80" cy="8" r="7" fill="${amber}" stroke="${ink}" stroke-width="3"/></svg>`,
  check: `<svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="26" fill="${amber}" stroke="${ink}" stroke-width="4"/><path d="M20 33l8 8 16-18" fill="none" stroke="${ink}" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  quote: `<svg viewBox="0 0 72 56"><path d="M6 52V30C6 16 14 8 28 4l2 8c-8 3-12 8-12 16h12v24zM42 52V30c0-14 8-22 22-26l2 8c-8 3-12 8-12 16h12v24z" fill="${amber}" stroke="${ink}" stroke-width="4" stroke-linejoin="round"/></svg>`,
  scissors: `<svg viewBox="0 0 72 64"><circle cx="16" cy="48" r="10" fill="#fff" stroke="${ink}" stroke-width="4"/><circle cx="16" cy="16" r="10" fill="#fff" stroke="${ink}" stroke-width="4"/><path d="M24 22l42 28M24 42l42-28" stroke="${ink}" stroke-width="4" stroke-linecap="round"/><path d="M40 32h4" stroke="${amber}" stroke-width="6" stroke-linecap="round"/></svg>`,
  question: `<svg viewBox="0 0 68 72"><path d="M8 6h52a4 4 0 0 1 4 4v38a4 4 0 0 1-4 4H30L16 66V52H8a4 4 0 0 1-4-4V10a4 4 0 0 1 4-4z" fill="${amber}" stroke="${ink}" stroke-width="4" stroke-linejoin="round"/><text x="34" y="40" text-anchor="middle" font-family="Manrope,sans-serif" font-weight="800" font-size="30" fill="${ink}">?</text></svg>`,
};
const items = [left && { ...left, side: 'left' }, right && { ...right, side: 'right' }].filter(Boolean) as (Item & { side: string })[];
---
<div class="s-gutter" aria-hidden="true">
  {items.map(i => (
    <span class={`s-gi s-gi-${i.side} gi-${i.icon}`} style={`--top:${i.top ?? '30%'}`}><i set:html={icons[i.icon]} /></span>
  ))}
</div>
