---
// The early-bird ticket: the offer, with both prices on the tear-off stub.
// Hover (or keyboard focus) tears the stub away along the perforation.
// The stub's plan buttons link to the registration form with that plan picked.
// Copy: register.json → ticket; prices: settings.json.
import { u } from '../../lib/url';
import { register, settings, t, rich, money } from '../../lib/content';
const tk = register.ticket;
const pr = settings.pricing;
const plans = [{ id: 'student', ...pr.student }, { id: 'others', ...pr.others }];
---
<div class="s-ticket-wrap">
<span class="s-ticket-hint" aria-hidden="true">✂ {tk.tearHint}</span>
<div class="s-ticket s-ticket-tear" id="ticket">
  <div class="s-ticket-main">
    <div class="s-ticket-top">
      <span class="s-ticket-brand"><img src={u('/img/brand/mark-black.png')} alt="" width="215" height="256" />{settings.brand.wordmark}</span>
      <span>{tk.ticketLabel}</span>
    </div>
    <h3 class="s-ticket-name">{tk.programName}</h3>
    <dl class="s-ticket-meta">{tk.details.map(d => <div><dt>{d.label}</dt><dd set:html={rich(d.value)} /></div>)}</dl>
    <ul class="s-ticket-incl">{pr.includes.map(i => <li>{t(i)}</li>)}</ul>
    <div class="s-ticket-join">
      <a href={u('/register#register')} class="s-btn s-btn-dark">{tk.joinButton} <span aria-hidden="true">→</span></a>
      <small>{tk.joinNote}</small>
    </div>
  </div>
  <div class="s-ticket-stub">
    <span class="s-ticket-tag">{tk.stubTag}</span>
    <div class="s-ticket-plans">
      {plans.map(pl => (
        <a href={u(`/register?plan=${pl.id}#register`)}><small>{pl.label}</small><b>{money(pl.price)}</b><span>{tk.chooseButton} →</span></a>
      ))}
    </div>
    <p class="s-ticket-was">{tk.regularLabel} <s>{money(pr.originalPrice)}</s></p>
    <p class="s-ticket-pay">{tk.payNote}</p>
    <div class="s-ticket-code" aria-hidden="true"><i></i><span>{tk.serial}</span></div>
  </div>
</div>
</div>
