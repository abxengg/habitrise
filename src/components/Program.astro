---
import { weeks } from '../data/site';
---
<section id="program">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">The program</span>
      <h2>Three weeks. Three phases. <em>One new you.</em></h2>
      <p>Every day is a live 6 AM session with a single focus. Open to everyone aged 12 and above.</p>
    </div>
    <div class="weeks">
      {weeks.map((w, wi) => (
        <article class:list={['week', 'reveal', { final: wi === weeks.length - 1 }]}>
          <div class="week-top"><span class="week-num">{w.num}</span><span class="week-days">{w.days}</span></div>
          <h3>{w.title}</h3>
          <p>{w.text}</p>
          <ol>
            {w.lessons.map((l, li) => <li><span>Day {wi * 7 + li + 1}</span>{l}</li>)}
          </ol>
        </article>
      ))}
    </div>
  </div>
</section>
