---
import Icon from './Icon.astro';
import { testimonials, initials } from '../data/site';
---
<section class="hero">
  <div class="wrap">
    <div class="reveal">
      <span class="pill"><span class="dot"></span>Live every morning at 6:00 AM IST</span>
      <h1>One habit.<br />One step.<br />One life <em>changed.</em></h1>
      <p class="lead">The 21-day habit system that has helped 5,000+ students and professionals build discipline, find purpose and rise every single day — together.</p>
      <div class="hero-ctas">
        <a href="/#join" class="btn btn-primary">Start your 21 days <Icon name="arrow" /></a>
        <a href="/#program" class="btn btn-ghost">See the program</a>
      </div>
      <div class="proof">
        <div class="avatars">{testimonials.slice(0, 5).map(t => <span style={`background:${t.color}`}>{initials(t.name)}</span>)}</div>
        <div><span class="stars">★★★★★</span> <b>4.9/5</b><small>Join 5,000+ early risers</small></div>
      </div>
    </div>

    <div class="hero-visual reveal">
      <div class="blob"></div>
      <img class="founder" src="/img/founder-hero.webp" alt="Manikandan Rajendran, HabitRise founder" width="900" height="900" fetchpriority="high" />
      <div class="float-card streak"><div class="flame">🔥</div><div><b>Day 14</b><small>Morning streak</small></div></div>
      <div class="float-card live"><span class="rec"></span> Live session · 6:00 AM</div>
      <div class="float-card today">
        <h4>Today's SAVERS <small>5 / 6</small></h4>
        <ul>
          {['Silence', 'Affirmations', 'Visualisation', 'Exercise', 'Reading · 10 pages'].map(h => <li class="done"><i></i><span>{h}</span></li>)}
          <li><i></i><span>Scribing</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>
<!-- Design C "Midnight": scrolling ticker under the hero -->
<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {[0, 1].map(() => (
      <span>Silence ✦ Affirmations ✦ Visualisation ✦ Exercise ✦ Reading ✦ Scribing ✦ Rise at 6 AM ✦ 21 days ✦&nbsp;</span>
    ))}
  </div>
</div>
