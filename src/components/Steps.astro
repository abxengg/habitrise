---
import { pricing } from '../data/site';
const steps = [
  { title: 'Reserve your spot', text: `Pay ₹${pricing.price} by UPI and submit your transaction ID on the registration page.` },
  { title: 'Get your community access', text: 'Once your payment is verified, your private Skool invite arrives by email within 24–48 hours.' },
  { title: 'Rise at 6 on Monday', text: 'The cohort starts together. Show up live, check in, and stack 21 mornings in a row.' },
];
---
<section class="steps-sec">
  <div class="wrap">
    <div class="section-head center reveal">
      <span class="eyebrow">How it works</span>
      <h2>From sign-up to <em>sunrise.</em></h2>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="reveal"><span class="n">{i + 1}</span><h3>{s.title}</h3><p>{s.text}</p></li>
      ))}
    </ol>
  </div>
</section>
