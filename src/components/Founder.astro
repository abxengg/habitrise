---
import { founder, socials } from '../data/site';
import Icon from './Icon.astro';
---
<section class="founder" id="founder">
  <div class="wrap">
    <div class="founder-grid">
      <div class="founder-photo reveal">
        <img src={founder.photo} alt={`${founder.name}, PMP-certified habit coach and HabitRise founder`} width="576" height="1024" />
        <div class="badge"><div><b>5000+</b><small>Students trained<br />across Tamil Nadu</small></div></div>
      </div>
      <div class="reveal">
        <span class="eyebrow">Meet your coach</span>
        <h2>{founder.name}</h2>
        <p class="role">{founder.role}</p>
        <blockquote>{founder.quote}</blockquote>
        <div class="bio">{founder.bio.map(p => <p>{p}</p>)}</div>
        <div class="creds">{founder.credentials.map(c => <span>{c}</span>)}</div>
        <a href="/about" class="btn btn-ghost story-link">Read the full story <Icon name="arrow" /></a>
        <div class="socials">
          {Object.entries(socials).map(([k, url]) => (
            <a href={url} target="_blank" rel="noopener noreferrer" aria-label={k}><Icon name={k} /></a>
          ))}
        </div>
      </div>
    </div>
    <div class="journey">
      {founder.journey.map(j => <div class="reveal"><h4>{j.title}</h4><p>{j.text}</p></div>)}
    </div>
  </div>
</section>
