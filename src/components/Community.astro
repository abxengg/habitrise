---
// Illustrative preview of the client's Skool community.
// TODO: swap the mock for a real screenshot of the HabitRise Skool group if available.
import Icon from './Icon.astro';

const features = [
  { icon: 'chat', title: 'Daily check-in feed', text: 'Post your SAVERS every morning. Celebrate wins, get nudged when you slip.' },
  { icon: 'book', title: 'Classroom', text: 'All 21 lessons, worksheets and replays — revisit any day, any time.' },
  { icon: 'calendar', title: 'Live 6 AM calendar', text: 'Every session in your calendar, plus direct Q&A with the founder.' },
  { icon: 'trophy', title: 'Leaderboard & levels', text: 'Earn points for showing up. Climb levels. Consistency becomes a game you win.' },
];
const leaders = [
  { i: 'PK', n: 'Praveen', c: '#2d9e5f', lv: 5, pts: 212 },
  { i: 'DR', n: 'Divya', c: '#c08a1a', lv: 4, pts: 186 },
  { i: 'AN', n: 'Arjun', c: '#6b5bd2', lv: 4, pts: 171 },
  { i: 'SP', n: 'Sneha', c: '#d2555b', lv: 3, pts: 150 },
  { i: 'KS', n: 'Karthik', c: '#2f7fb5', lv: 3, pts: 138 },
];
const tabs = [['feed', 'Community'], ['classroom', 'Classroom'], ['calendar', 'Calendar'], ['leaderboard', 'Leaderboard']];
---
<section class="community" id="community">
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow">The community</span>
      <h2>You won't rise <em>alone.</em></h2>
      <p class="intro">Every member gets access to the private HabitRise community on Skool — the place where the 6 AM crew checks in, learns, and keeps each other honest.</p>
      <div class="features">
        {features.map(f => (
          <div class="feature">
            <div class="ico"><Icon name={f.icon} /></div>
            <div><h4>{f.title}</h4><p>{f.text}</p></div>
          </div>
        ))}
      </div>
      <a href="/#join" class="btn btn-gold">Join the 6 AM crew</a>
    </div>

    <div class="reveal">
      <div class="app" role="img" aria-label="Preview of the HabitRise community on Skool">
        <div class="app-bar">
          <img class="g" src="/img/logo.webp" alt="" width="32" height="32" />
          <div><b>HabitRise 6 AM Club</b><small>Private community · Skool</small></div>
        </div>
        <div class="app-tabs" role="tablist">
          {tabs.map(([id, label], i) => <button class={i === 0 ? 'on' : ''} data-tab={id}>{label}</button>)}
        </div>
        <div class="app-body">
          <div class="app-main">
            <div class="panel on" data-panel="feed">
              <div class="post">
                <div class="post-head"><div class="av" style="background:#2d9e5f">PK<span class="lv">5</span></div><div><b>Praveen</b><small>5:58 AM · Day 14</small></div><span class="tag">Check-in</span></div>
                <p>All six SAVERS done before 6:30 ✅ Day 14 — two weeks without missing a morning. Never thought I'd write that.</p>
                <div class="meta"><span>👍 42</span><span>💬 9 comments</span></div>
              </div>
              <div class="post">
                <div class="post-head"><div class="av" style="background:#c08a1a">DR<span class="lv">4</span></div><div><b>Divya</b><small>6:12 AM · Day 9</small></div><span class="tag">Win</span></div>
                <p>Finished my first book in years thanks to the 10-pages rule 📚 Anyone want my notes?</p>
                <div class="meta"><span>👍 27</span><span>💬 6 comments</span></div>
              </div>
              <div class="post">
                <div class="post-head"><div class="av" style="background:#0d2818">MR<span class="lv">9</span></div><div><b>Manikandan</b><small>Founder · 6:45 AM</small></div><span class="tag" style="background:#fff7dc;color:#8a6b00">Announcement</span></div>
                <p>Tomorrow is Day 15: Focus &amp; Deep Work. Bring a notebook and one task you've been avoiding.</p>
              </div>
            </div>
            <div class="panel" data-panel="classroom">
              <div class="lesson"><span class="n">W1</span><div><b>Foundation</b><small>7 lessons · Purpose &amp; vision</small></div><span class="bar"><i style="width:100%"></i></span></div>
              <div class="lesson"><span class="n">W2</span><div><b>Build the System</b><small>7 lessons · Fear &amp; routine</small></div><span class="bar"><i style="width:60%"></i></span></div>
              <div class="lesson locked"><span class="n">W3</span><div><b>Complete Transformation</b><small>7 lessons · Focus &amp; identity</small></div><span class="bar"><i style="width:0"></i></span></div>
              <div class="lesson"><span class="n">📄</span><div><b>SAVERS Daily Tracker</b><small>Printable worksheet</small></div></div>
            </div>
            <div class="panel" data-panel="calendar">
              <div class="cal-row"><div class="d"><small>Mon</small><b>1</b></div><div><b>Day 1 · Find Your Purpose (IKIGAI)</b><div class="t">6:00 – 6:45 AM IST · Live</div></div></div>
              <div class="cal-row"><div class="d"><small>Tue</small><b>2</b></div><div><b>Day 2 · Own Your Life 100%</b><div class="t">6:00 – 6:45 AM IST · Live</div></div></div>
              <div class="cal-row"><div class="d"><small>Wed</small><b>3</b></div><div><b>Day 3 · Map Your Life</b><div class="t">6:00 – 6:45 AM IST · Live</div></div></div>
              <div class="cal-row"><div class="d"><small>Sun</small><b>7</b></div><div><b>Weekly Q&amp;A with the Founder</b><div class="t">Live · Ask anything</div></div></div>
            </div>
            <div class="panel" data-panel="leaderboard">
              <div class="post">
                <ol class="lb">
                  {leaders.map((l, i) => <li><span class="rank">{i + 1}</span><div class="av" style={`background:${l.c}`}>{l.i}<span class="lv">{l.lv}</span></div>{l.n}<span class="pts">+{l.pts}</span></li>)}
                </ol>
              </div>
            </div>
          </div>
          <aside class="app-side">
            <h5>This week</h5>
            <ol class="lb">
              {leaders.slice(0, 3).map((l, i) => <li><span class="rank">{i + 1}</span><div class="av" style={`background:${l.c}`}>{l.i}</div>{l.n}<span class="pts">+{l.pts}</span></li>)}
            </ol>
            <div class="levels">
              <h5 style="margin:8px 0 2px">Levels</h5>
              {[[1, 'Early Riser'], [3, 'Habit Builder'], [5, 'Disciplined'], [9, 'HabitRise Leader']].map(([n, t]) => <div class="lvl"><i>{n}</i>{t}</div>)}
            </div>
          </aside>
        </div>
      </div>
      <p class="app-note">Illustrative preview of the members-only community</p>
    </div>
  </div>
</section>
