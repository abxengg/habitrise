---
import { contact, socials } from '../data/site';
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <div class="foot">
      <div>
        <a href="/" class="brand"><img src="/img/logo.webp" alt="" width="36" height="36" /><span>Habit<em>Rise</em></span></a>
        <p>India's most disciplined morning accountability community. Build the habits that change your life in 21 days.</p>
      </div>
      <div>
        <h5>Explore</h5>
        <ul><li><a href="/#program">The Program</a></li><li><a href="/#community">Community</a></li><li><a href="/#founder">Founder Story</a></li><li><a href="/#stories">Success Stories</a></li></ul>
      </div>
      <div>
        <h5>Contact</h5>
        <ul><li><a href={`mailto:${contact.email}`}>Email</a></li><li><a href={contact.whatsapp}>WhatsApp Support</a></li><li><a href={socials.instagram}>Instagram</a></li><li><a href={socials.youtube}>YouTube</a></li></ul>
      </div>
      <div>
        <h5>Legal</h5>
        <ul><li><a href="https://habitrise.in/terms">Terms of Service</a></li><li><a href="https://habitrise.in/privacy">Privacy Policy</a></li></ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© {year} HabitRise. Build • Grow • Inspire.</span>
      <span>Made for early risers 🌅</span>
    </div>
  </div>
</footer>

